// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.3-codex",
        "reasoning_effort": "medium"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5-codex",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "format_on_save": "off",
  "formatter": {
    "external": {
      "command": "pnpm",
      "arguments": ["-s", "prettier", "--stdin-filepath", "{buffer_path}"],
    },
  },
  "prettier": {
    "require_config": true,
  },
  "ui_font_size": 17.0,
  "buffer_font_size": 17.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": false
    },
    "MDX": {
      "show_edit_predictions": false
    },
    "Plain Text": {
      "show_edit_predictions": false
    }
  }
}
